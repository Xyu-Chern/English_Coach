ARG EMBEDDING_PROVIDER=openai
FROM python:3.13-alpine3.23 AS cloud
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.txt

FROM cloud AS base-openai
FROM cloud AS base-google
FROM python:3.11-slim-bookworm AS base-local
COPY --from=busybox:1.37.0-musl /bin/busybox /usr/local/bin/busybox
COPY requirements.txt requirements-local.txt /tmp/
RUN busybox crond --help && pip install --no-cache-dir -r /tmp/requirements-local.txt

FROM base-${EMBEDDING_PROVIDER} AS worker

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache \
    TZ=UTC

WORKDIR /app
# Cache the public tokenizer vocabulary at build time; corpus jobs run locally.
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Copy the package explicitly; credentials and downloaded transcripts stay on the host.
COPY *.py /app/translation_agent_demo/
COPY providers/ /app/translation_agent_demo/providers/
COPY corpus/ /app/translation_agent_demo/corpus/
COPY storage/ /app/translation_agent_demo/storage/
COPY jobs/ /app/translation_agent_demo/jobs/
COPY tools/ /app/translation_agent_demo/tools/
COPY agents/ /app/translation_agent_demo/agents/
COPY --chmod=0600 docker/podcast-sync.crontab /etc/crontabs/root

# Alpine provides BusyBox crond. The schedule, not container startup, starts API work.
CMD ["busybox", "crond", "-c", "/etc/crontabs", "-f", "-l", "8", "-L", "/dev/stdout"]
