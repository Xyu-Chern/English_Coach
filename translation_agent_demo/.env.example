# Copy this file to .env and set values for an OpenAI-compatible Chat Completions provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model
LLM_TIMEOUT_SECONDS=30
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=8000

PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
# Local PostgreSQL. Keep the URL port aligned with POSTGRES_PORT.
DATABASE_URL=postgresql://english_coach@127.0.0.1:5433/english_coach
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Explicit subscriptions only: up to 30 comma-separated feed IDs.
# Worker runs every 3 minutes (UTC), one feed per run; metadata refresh is every 90 minutes per feed.
PODCAST_SYNC_ENABLED=true
PODCAST_SYNC_FEED_IDS=6923748,6407010,7377647,6663438,50395,7615847,7001317,4595096,466383,664599,7047738,5302879,6693197,127099,1034102,6570114,4129510,3027936,6952884,6666462,9196,7636547,1384903,2615356,837653,1329621,6724022,7078513,7868498,6596101

# Parse/chunk up to 10 stored transcripts every 3 minutes; no LLM or publisher calls.
CORPUS_BUILD_ENABLED=true
