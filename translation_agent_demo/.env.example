# Copy this file to .env and set values for an OpenAI-compatible Chat Completions provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model
LLM_TIMEOUT_SECONDS=30
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=8000

PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
# Local PostgreSQL. Keep the URL port aligned with POSTGRES_PORT.
DATABASE_URL=postgresql://english_coach@127.0.0.1:5433/english_coach
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Up to 30 explicit feeds; only feeds with a recorded transcript-source review are collected.
# Changelog uses its CC BY-SA 4.0 transcript repository, not the website/audio terms.
# One feed every 3 minutes (UTC); recent metadata refresh every 90 minutes per feed.
PODCAST_SYNC_ENABLED=true
PODCAST_SYNC_FEED_IDS=542376

# Parse/chunk up to 10 stored transcripts every 3 minutes; no LLM or publisher calls.
CORPUS_BUILD_ENABLED=true

# OpenAI or Google, both stored at 1536 dimensions under distinct model names.
EMBEDDING_PROVIDER=openai
# For EMBEDDING_PROVIDER=google, use a Gemini API key.
GEMINI_API_KEY=
# EVAL_SNAPSHOT_DIR=evaluation/.local/snapshots/my-google-corpus
CORPUS_EMBED_ENABLED=false
# Optional dedicated key. Falls back to OPENAI_API_KEY, then an official-OpenAI LLM_API_KEY.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# Evaluation (python -m evaluation.eval). Defaults stay OpenAI. The reported runs generated
# with Claude Haiku 5.5 (both systems) and judged with the pinned OpenAI default:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=medium
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-5.4-mini-2026-03-17
# OPENAI_API_KEY=
